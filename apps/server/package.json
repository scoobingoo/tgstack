{
  "name": "@tgstack/server",
  "version": "0.0.0",
  "private": true,
  "description": "tgstack NestJS server: Telegram bot, REST API and queue worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c gray,blue,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\" \"node --watch dist/main.worker.js\"",
    "dev:api": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c gray,blue \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:mock": "tsc -p tsconfig.build.json && node dist/dev/mock-bot.js"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/runner": "^2.0.3",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@tgstack/db": "workspace:*",
    "@tgstack/i18n": "workspace:*",
    "@tgstack/nestjs-grammy": "workspace:*",
    "@tgstack/shared": "workspace:*",
    "bullmq": "^6.3.19",
    "cookie-parser": "^1.4.7",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@tgstack/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
