# Optional overrides for apps/miniapp. The root .env is loaded too (this file wins).
# Server base URL. In development the dev server proxies /api to it; production builds
# call it directly when set (leave empty when the Mini App and API share a domain).
# VITE_API_URL=http://localhost:3000
# Path the app is served under in production (e.g. /app/ behind the reverse proxy).
# MINIAPP_BASE_PATH=/
