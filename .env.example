# ─────────────────────────────────────────────────────────────────────────────
# tgstack — root environment file.
# Copy to `.env` and fill in the blanks. Docker Compose and every app read it.
# Apps also accept an app-local .env (e.g. apps/server/.env) that wins over this one.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Infrastructure (docker-compose.yml) ──────────────────────────────────────
POSTGRES_USER=tgstack
POSTGRES_PASSWORD=tgstack
POSTGRES_DB=tgstack
# Host ports — change them if 5432/6379 are already used on your machine
# (and update the URLs below to match).
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://tgstack:tgstack@127.0.0.1:5432/tgstack
REDIS_URL=redis://127.0.0.1:6379
# Integration tests only. Each package creates its own <name>_<package> database from it.
TEST_DATABASE_URL=postgresql://tgstack:tgstack@127.0.0.1:5432/tgstack_test
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# ── Server (apps/server) ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Bot token from @BotFather (required).
BOT_TOKEN=
# polling (development) | webhook (production)
BOT_MODE=polling
# Webhook mode: public base URL of the server; the bot listens on <url>/telegram/webhook.
BOT_WEBHOOK_URL=
# Webhook mode: random string (A-Z a-z 0-9 _ -) Telegram sends in a header with every update.
BOT_WEBHOOK_SECRET=
# true = call setWebhook on boot (webhook mode).
BOT_AUTO_SET_WEBHOOK=false
# true = use Telegram's test environment (test accounts, free test payments).
BOT_TEST_ENVIRONMENT=false

# Comma-separated Telegram user IDs promoted to ADMIN on seed and on boot.
# Find yours by sending a message to @userinfobot.
ADMIN_TELEGRAM_IDS=
# Signs admin session cookies. At least 32 characters: `openssl rand -hex 32`.
JWT_SECRET=

# Public URLs (magic links, CORS, Mini App buttons).
ADMIN_URL=http://localhost:3001
MINIAPP_URL=http://localhost:5173

# How long a Mini App session (initData) stays valid, in seconds.
INITDATA_MAX_AGE_SECONDS=86400
# Broadcast speed. Telegram allows about 30 messages/second in bulk; stay below it.
BROADCAST_RATE_PER_SECOND=25

# ── Admin dashboard (apps/admin) ─────────────────────────────────────────────
# Where the server listens; the dashboard proxies /api/* there (same-origin cookies).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional: your bot's username without @, for the "Open the bot" button on the login page.
NEXT_PUBLIC_BOT_USERNAME=
