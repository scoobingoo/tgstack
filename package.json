{
  "name": "tgstack",
  "version": "0.0.0",
  "private": true,
  "description": "Production-ready full-stack Telegram starter: NestJS + grammY bot, Mini App, admin dashboard, rate-limited broadcasts and Telegram Stars payments.",
  "license": "MIT",
  "author": "Son Le <sonlocle36123@gmail.com> (https://github.com/scoobingoo)",
  "homepage": "https://github.com/scoobingoo/tgstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobingoo/tgstack.git"
  },
  "bugs": {
    "url": "https://github.com/scoobingoo/tgstack/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tgstack/db run generate",
    "db:migrate": "pnpm --filter @tgstack/db run migrate:dev",
    "db:deploy": "pnpm --filter @tgstack/db run migrate:deploy",
    "db:seed": "pnpm --filter @tgstack/db run seed",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@tgstack/nestjs-grammy && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.5",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
